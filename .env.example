# Local development. Copy to .env — never commit secrets.

# Optional. When unset, the API reads snapshot JSON from frontend/public/data.
DATABASE_URL=postgresql://iceatlas:iceatlas@localhost:5432/iceatlas

# FastAPI
CORS_ORIGINS=http://127.0.0.1:3847,http://localhost:3847
DATA_DIR=frontend/public/data

# Terraform / cloud (leave empty for local-only)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=colorado-ice-atlas
SUPABASE_PROJECT_URL=
SUPABASE_DB_PASSWORD=

# Optional satellite / weather overrides
OPEN_METEO_BASE=https://api.open-meteo.com/v1/forecast
STAC_SEARCH=https://planetarycomputer.microsoft.com/api/stac/v1/search
